# ============================================
# Interview Generator v2 - Environment Example
# ============================================
# Copy this file to backend/.env and replace
# placeholder values with your actual secrets.

APP_NAME=Interview Generator
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/interview_platform

SECRET_KEY=replace-with-a-secure-random-secret-key
ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
UPLOAD_DIR=./uploads

OPENAI_API_KEY=your-openai-api-key

CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

CELERY_RESULT_BACKEND=redis://localhost:6379/0